# SQLite database file used by Prisma.
DATABASE_URL="file:./dev.db"

# Public base URL of the app (used by server fetch in API routes).
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Host port for Docker. Change this if port 3000 is already in use on your
# machine (e.g. APP_PORT=3001 -> open http://localhost:3001). Docker Compose
# reads this file automatically.
APP_PORT=3000
