# =============================================================================
# SPORT LINER — настройки сервера.
# Скопируйте этот файл в `.env` и заполните:   cp .env.example .env
# Подробная инструкция по запуску — ЗАПУСК-ПРОДАЖ.md.
# Контакты, реквизиты и соцсети магазина задаются НЕ здесь, а в админке:
# /admin/settings.
# =============================================================================

# --- Адрес сайта -------------------------------------------------------------
# Публичный адрес магазина (с https:// на боевом сервере). Используется в
# письмах, ссылке возврата из ЮKassa, sitemap и превью в соцсетях.
SITE_URL="http://localhost:3000"

# Домен для автоматического HTTPS-сертификата (только docker-compose.prod.yml).
DOMAIN="shop.example.ru"

# --- Администратор -----------------------------------------------------------
# Создаётся при запуске, если его ещё нет. Пароль — не короче 10 символов.
# Существующий пароль не перезаписывается; чтобы сбросить забытый пароль,
# один раз запустите с ADMIN_RESET_PASSWORD=true.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_RESET_PASSWORD=false

# --- Уведомления о заказах и заявках -----------------------------------------
# Telegram: создайте бота у @BotFather, добавьте его в чат/группу менеджеров
# и узнайте chat id (инструкция в ЗАПУСК-ПРОДАЖ.md).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Почта (SMTP): письма покупателям, сброс пароля, копии уведомлений менеджеру.
# Пример для Яндекс 360: smtp.yandex.ru, порт 465, пароль приложения.
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SPORT LINER <shop@example.ru>"
# Куда слать уведомления менеджеру. Пусто — на email из /admin/settings.
NOTIFY_EMAIL=""

# --- Онлайн-оплата (ЮKassa) ---------------------------------------------------
# Пусто — онлайн-оплата не предлагается, заказ подтверждает менеджер.
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
# Отправлять чеки по 54-ФЗ через «Чеки от ЮKassa» (включите их в кабинете ЮKassa).
YOOKASSA_SEND_RECEIPT=false
# Ставка НДС для чеков: 1 — без НДС (УСН), 2 — 0%, 3 — 10%, 4 — 20%.
YOOKASSA_VAT_CODE=1

# --- Поисковики --------------------------------------------------------------
# true — разрешить индексацию (robots.txt, sitemap). Включайте, когда каталог,
# цены, фото и реквизиты — настоящие.
SITE_INDEXABLE=false

# --- HTTPS -------------------------------------------------------------------
# true — cookie входа только по HTTPS. На боевом сервере с HTTPS — true,
# при локальном запуске по http://localhost — false (иначе вход не работает).
SESSION_COOKIE_SECURE=false

# --- Рассрочка ---------------------------------------------------------------
# Срок в месяцах для строки «X ₽ / мес» под ценой. 0 — не показывать.
# Включайте, только если рассрочка реально подключена (банк или «Оплата
# частями» в ЮKassa). Применяется при сборке (docker compose up --build).
NEXT_PUBLIC_INSTALLMENT_MONTHS=0

# --- Тестовый режим (только для локального просмотра!) -----------------------
# DEMO_ACCOUNTS=true создаёт admin@movigym.test / admin1234 и
# demo@movigym.test / demo1234 и показывает их на странице входа.
# DEMO_EXPOSE_RESET_TOKEN=true показывает код сброса пароля на экране.
# На боевом сервере ОБА должны быть false.
DEMO_ACCOUNTS=false
DEMO_EXPOSE_RESET_TOKEN=false

# --- Техническое -------------------------------------------------------------
# Файл базы данных SQLite (путь относительно папки prisma/). В Docker
# переопределяется на /app/data/dev.db (постоянный том).
DATABASE_URL="file:./dev.db"
# Порт на компьютере для локального docker compose.
APP_PORT=3000
