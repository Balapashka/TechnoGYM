# Copy this file to `.env` before running the app locally:
#   cp .env.example .env

# SQLite database file used by Prisma. The path is relative to prisma/.
DATABASE_URL="file:./dev.db"

# Public origin of the site. Used for canonical URLs, robots.txt and the
# sitemap. Change it to the real domain when deploying. Read at runtime, so a
# Docker deployment can override it without rebuilding the image.
SITE_URL="http://localhost:3000"

# Host port for Docker. Change this if port 3000 is already in use on your
# machine (e.g. APP_PORT=3001 -> open http://localhost:3001). Docker Compose
# reads this file automatically.
APP_PORT=3000

# --- Demo switches -----------------------------------------------------------
# There is no mail server, so the password-reset token is returned in the API
# response and shown on screen. Anyone who knows an email address could then
# reset that account, so REMOVE THIS (or set it to false) on any public
# deployment.
DEMO_EXPOSE_RESET_TOKEN=true

# --- Production switches -----------------------------------------------------
# Mark the session cookie `Secure`. Leave false while serving over plain HTTP
# (the cookie would not be sent back and login would fail); set to true once the
# site is served over HTTPS.
SESSION_COOKIE_SECURE=false

# Allow search engines to index the site. Off by default because the catalog
# names real manufacturers with invented prices — turn it on only once the
# content is real.
SITE_INDEXABLE=false
