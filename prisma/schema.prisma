generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  parentId  String?
  createdAt DateTime   @default(now())
  parent    Category?  @relation("Tree", fields: [parentId], references: [id])
  children  Category[] @relation("Tree")
  products  Product[]
}

model Product {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String
  priceCents  Int
  currency    String      @default("RUB")
  images      String
  features    String
  badge       String?
  inStock     Boolean     @default(true)
  /// Manufacturer, e.g. "Technogym". Empty string = unknown (kept non-null so
  /// the column can be added to existing rows without a data migration).
  brand         String    @default("")
  /// Country of origin in Russian, e.g. "Италия".
  originCountry String    @default("")
  /// Hide the price in the storefront and offer a quote request instead.
  /// Imported-to-order equipment (Technogym, Panatta) is sold this way; the
  /// stocked UNIX Fit range keeps its public price. `priceCents` stays filled
  /// so admins and internal reports still see a figure.
  priceOnRequest Boolean  @default(false)
  /// "new" or "used" (б/у). A used unit always shows its price and sells
  /// through the cart, whatever its brand; the storefront marks it «Б/у».
  condition   String      @default("new")
  categoryId  String
  createdAt   DateTime    @default(now())
  cartItems   CartItem[]
  orderItems  OrderItem[]
  quoteRequests QuoteRequest[]
  category    Category    @relation(fields: [categoryId], references: [id])
  variants    Variant[]
}

model Variant {
  id              String     @id @default(cuid())
  productId       String
  name            String
  priceDeltaCents Int        @default(0)
  cartItems       CartItem[]
  product         Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  password         String
  role             String    @default("USER")
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  carts            Cart[]
  orders           Order[]
  sessions         Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  sessionId String?
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id])
  items     CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int      @default(1)
  variant   Variant? @relation(fields: [variantId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
}

model Order {
  id         String      @id @default(cuid())
  userId     String?
  email      String
  status     OrderStatus @default(PENDING)
  totalCents Int
  currency   String      @default("RUB")
  /// Customer contact and delivery details captured at checkout.
  customerName   String  @default("")
  phone          String  @default("")
  /// "delivery" (to the address below) or "pickup" (from the store's warehouse).
  deliveryMethod String  @default("delivery")
  country        String  @default("RU")
  city           String  @default("")
  address        String  @default("")
  postalCode     String  @default("")
  comment        String?
  /// "manual" (the manager confirms and arranges payment) or "online" (YooKassa).
  paymentMethod  String  @default("manual")
  /// Payment provider id (YooKassa payment id) for online payments.
  paymentId      String?
  /// Internal note visible only in the admin panel.
  adminNote      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @default(now()) @updatedAt
  user       User?       @relation(fields: [userId], references: [id])
  items      OrderItem[]

  @@index([createdAt])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  /// Null once the product is deleted from the catalog; the snapshots below
  /// keep the order readable.
  productId    String?
  nameSnapshot String
  /// Selected configuration at the time of the order, e.g. "Pro".
  variantName  String?
  priceCents   Int
  quantity     Int
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

/// Lead captured by the "Запросить цену" form on quote-only products
/// (Product.priceOnRequest). This is the real sales channel for the imported
/// range, which carries no public price.
model QuoteRequest {
  id        String             @id @default(cuid())
  productId String?
  /// Product name at the time of the request; kept if the product is removed.
  productName String
  /// Where the lead came from: "product" (price request), "business" or "contact".
  source    String             @default("product")
  name      String
  phone     String
  email     String?
  comment   String?
  status    QuoteRequestStatus @default(NEW)
  createdAt DateTime           @default(now())
  product   Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

enum QuoteRequestStatus {
  NEW
  CONTACTED
  CLOSED
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

/// Newsletter subscription from the footer form.
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

/// Store settings editable in the admin panel (contacts, legal details,
/// socials). Key/value so a new setting needs no migration; defaults live in
/// src/lib/settings.ts.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}
